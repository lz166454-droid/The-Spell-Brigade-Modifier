QPushButton#primaryBtn {
    background-color: {{accent_magic}};
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font: 11px 'Microsoft YaHei UI';
    padding: 0 10px;
    min-height: 22px;
    max-height: 24px;
}

QPushButton#primaryBtn:hover {
    background-color: {{accent_magic}};
}

QPushButton#primaryBtn:pressed {
    background-color: {{accent_magic}};
}

QPushButton#primaryBtn:disabled {
    background-color: {{border_subtle}};
    color: {{text_muted}};
}

QPushButton#primaryBtn:focus {
    outline: none;
    background-color: {{accent_magic}};
    border: none;
}

QPushButton#secondaryBtn {
    background-color: transparent;
    color: {{text_primary}};
    border: 1px solid {{border_subtle}};
    border-radius: 4px;
    font: 11px 'Microsoft YaHei UI';
    padding: 0 10px;
    min-height: 22px;
    max-height: 24px;
}

QPushButton#secondaryBtn:hover {
    background-color: {{nav_bg_hover}};
    border-color: {{border_focus}};
}

QPushButton#secondaryBtn:pressed {
    background-color: {{nav_bg_pressed}};
}

QPushButton#secondaryBtn:focus {
    outline: none;
    background-color: transparent;
    border: 1px solid {{border_subtle}};
}

QPushButton#trainerStartBtn {
    background-color: transparent;
    color: {{text_primary}};
    border: 1px solid {{border_subtle}};
    border-radius: 4px;
    font: 11px 'Microsoft YaHei UI';
    padding: 0 10px;
    min-height: 22px;
    max-height: 24px;
}

QPushButton#trainerStartBtn:hover {
    background-color: {{nav_bg_hover}};
    border-color: {{border_focus}};
}

QPushButton#trainerStartBtn:pressed {
    background-color: {{nav_bg_pressed}};
}

QPushButton#trainerStartBtn:focus {
    outline: none;
    background-color: transparent;
    border: 1px solid {{border_subtle}};
}

QPushButton#trainerStartBtnActive {
    background-color: {{accent_success}};
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font: 11px 'Microsoft YaHei UI';
    padding: 0 10px;
    min-height: 22px;
    max-height: 24px;
}

QPushButton#trainerStartBtnActive:disabled {
    background-color: {{accent_success}};
    color: #ffffff;
}

QPushButton#trainerStartBtnActive:focus {
    outline: none;
    background-color: {{accent_success}};
    border: none;
}

QPushButton#goldPresetBtn {
    background-color: {{bg_card}};
    color: {{accent_gold}};
    border: 1px solid {{border_subtle}};
    border-radius: 4px;
    font: 12px 'Consolas';
    padding: 2px 10px;
    min-height: 22px;
    max-height: 24px;
}

QPushButton#goldPresetBtn:hover {
    border-color: {{accent_gold}};
    background-color: {{nav_bg_hover}};
}

QPushButton#goldPresetBtn:focus {
    outline: none;
    border: 1px solid {{border_subtle}};
    background-color: {{bg_card}};
}

QPushButton#trainerPresetApplyBtn {
    background-color: {{accent_magic}};
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font: 11px 'Microsoft YaHei UI';
    padding: 0 10px;
    min-height: 22px;
    max-height: 24px;
}

QPushButton#trainerPresetApplyBtn:hover {
    background-color: {{accent_magic}};
    border: 1px solid {{border_focus}};
}

QPushButton#trainerPresetApplyBtn:pressed {
    background-color: {{nav_bg_pressed}};
    color: {{text_primary}};
    border: 1px solid {{border_focus}};
    padding-top: 2px;
    padding-bottom: 0;
}

QPushButton#trainerPresetApplyBtn:disabled {
    background-color: {{border_subtle}};
    color: {{text_muted}};
    border: none;
    padding: 0 10px;
}

QPushButton#trainerPresetApplyBtn:focus {
    outline: none;
    border: none;
}

QPushButton#trainerPresetApplyBtnFlash {
    background-color: {{accent_success}};
    color: #0f0e17;
    border: none;
    border-radius: 4px;
    font: 11px 'Microsoft YaHei UI';
    padding: 0 10px;
    min-height: 22px;
    max-height: 24px;
}

QPushButton#trainerPresetApplyBtnFlash:disabled {
    background-color: {{accent_success}};
    color: #0f0e17;
}

QToolButton#toolbarBtn {
    background: transparent;
    border: 1px solid {{border_subtle}};
    border-radius: 4px;
    color: {{text_primary}};
    font: 12px 'Microsoft YaHei UI';
    padding: 2px 10px;
    min-height: 24px;
    max-height: 26px;
}

QToolButton#toolbarBtn:hover {
    background: {{nav_bg_hover}};
    border-color: {{border_focus}};
}

QToolButton#toolbarBtn:disabled {
    color: {{text_muted}};
    border-color: {{border_subtle}};
}

QToolButton#toolbarBtn:focus {
    outline: none;
    background: transparent;
    border: 1px solid {{border_subtle}};
}

QComboBox#toolbarCombo {
    background-color: transparent;
    color: {{text_primary}};
    border: 1px solid {{border_subtle}};
    border-radius: 4px;
    font: 11px 'Microsoft YaHei UI';
    padding: 0 20px 0 10px;
    min-height: 22px;
    max-height: 24px;
    min-width: 0;
}

QComboBox#toolbarCombo:hover {
    background-color: {{nav_bg_hover}};
    border-color: {{border_focus}};
}

QComboBox#toolbarCombo:focus,
QComboBox#toolbarCombo:on,
QComboBox#toolbarCombo:open {
    outline: none;
    background-color: transparent;
    border: 1px solid {{border_subtle}};
}

QComboBox#toolbarCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 18px;
    border: none;
    border-left: 1px solid {{border_subtle}};
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    background: transparent;
}

QComboBox#toolbarCombo::drop-down:hover {
    background: {{nav_bg_hover}};
}

QComboBox#toolbarCombo::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid {{text_secondary}};
}

QComboBox#toolbarCombo::down-arrow:on,
QComboBox#toolbarCombo::down-arrow:open {
    border-top: none;
    border-bottom: 5px solid {{text_secondary}};
}
