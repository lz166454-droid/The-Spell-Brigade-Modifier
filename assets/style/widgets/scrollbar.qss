QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea#panelScroll {
    background: {{bg_card}};
    border: none;
}

QScrollArea#panelScroll > QWidget > QWidget,
QWidget#panelScrollViewport {
    background: {{bg_card}};
}

QWidget#panelScrollContent {
    background: {{bg_card}};
}

QTabWidget#saveEditTabs QScrollArea#panelScroll,
QTabWidget#saveEditTabs QScrollArea#panelScroll > QWidget > QWidget,
QTabWidget#saveEditTabs QWidget#panelScrollViewport,
QTabWidget#saveEditTabs QScrollArea#panelScroll QWidget#panelScrollContent {
    background: {{bg_page_surface}};
}

QTabWidget#saveEditTabs QScrollArea#panelScroll QScrollBar:vertical,
QTabWidget#trainerTabs QScrollArea#panelScroll QScrollBar:vertical {
    background: {{bg_page_surface}};
}

QTabWidget#saveEditTabs QScrollArea#panelScroll QScrollBar::add-page:vertical,
QTabWidget#saveEditTabs QScrollArea#panelScroll QScrollBar::sub-page:vertical,
QTabWidget#trainerTabs QScrollArea#panelScroll QScrollBar::add-page:vertical,
QTabWidget#trainerTabs QScrollArea#panelScroll QScrollBar::sub-page:vertical {
    background: {{bg_page_surface}};
}

QTabWidget#trainerTabs QScrollArea#panelScroll,
QTabWidget#trainerTabs QScrollArea#panelScroll > QWidget > QWidget,
QTabWidget#trainerTabs QWidget#panelScrollViewport,
QTabWidget#trainerTabs QScrollArea#panelScroll QWidget#panelScrollContent {
    background: {{bg_page_surface}};
}

QScrollArea#trainerBasicScroll {
    background: {{bg_page_surface}};
    border: none;
}

QScrollArea#trainerBasicScroll > QWidget > QWidget,
QWidget#trainerBasicScrollViewport {
    background: {{bg_page_surface}};
}

QScrollArea#trainerBasicScroll QWidget#panelScrollContent {
    background: {{bg_page_surface}};
}

QScrollArea#trainerBasicScroll QScrollBar:vertical {
    background: {{bg_page_surface}};
}

QScrollArea#trainerBasicScroll QScrollBar::add-page:vertical,
QScrollArea#trainerBasicScroll QScrollBar::sub-page:vertical {
    background: {{bg_page_surface}};
}

QStackedWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: {{bg_card}};
    width: 8px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: {{scrollbar_handle}};
    border-radius: 4px;
    min-height: 30px;
    border: none;
}

QScrollBar::handle:vertical:hover {
    background: {{scrollbar_handle_hover}};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: {{bg_card}};
    border: none;
}

QScrollBar:horizontal {
    background: {{scrollbar_bg}};
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: {{scrollbar_handle}};
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: {{scrollbar_handle_hover}};
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
